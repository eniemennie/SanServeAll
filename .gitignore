# Secrets
.env
.env.*
!.env.example
!deployment/**/env.*.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Django
backend/media/
backend/logs/
backend/db.sqlite3
backend/staticfiles/

# Backups (never committed, only ever local/temporary)
database/backups/*
!database/backups/.gitkeep

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
desktop.ini

# Local scratch artifacts from running seed/removal scripts against a
# developer database -- regenerated fresh per-run, tied to whatever
# local DB state exists at seed time, and meaningless outside that
# specific database (production and any other environment each have
# their own, already excluded from git the same way).
backend/scripts/sample_data_manifest.json
backend/scripts/synthetic_backfill_manifest.json
