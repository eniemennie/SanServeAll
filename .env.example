# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True

# Database (SQLite is used automatically in development; these are only
# needed when running against MySQL locally, or in staging/production)
DB_NAME=sanserveall_dev
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Branch configuration (Phase 2/4 decision — confirmed: Alangilan)
KAHERO_BRANCH=Alangilan

# AI API (Phase 1 FR-04: natural-language insight generation).
# Free tier via Google AI Studio (aistudio.google.com/apikey) -- no
# credit card, no expiration. Leave blank to use the plain-template
# fallback instead of a live API call.
GEMINI_API_KEY=

# Allowed hosts (staging/production only)
STAGING_ALLOWED_HOSTS=
PRODUCTION_ALLOWED_HOSTS=
