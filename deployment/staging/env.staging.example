# Staging environment variables — real values live only on the staging
# PythonAnywhere instance, never committed.
SECRET_KEY=
DEBUG=False
# SQLite is used here, not MySQL (free-tier budget constraint -- see
# production.py's module comment for the full reasoning). This only needs
# setting if you want the database file somewhere other than the default
# ~/data/sanserveall_staging.sqlite3.
SQLITE_DB_PATH=
KAHERO_BRANCH=Alangilan
# Natural-language insight generation (Row 11.2), via the Gemini API's free
# tier. Leave blank to use the plain-template fallback instead of a live call.
GEMINI_API_KEY=
STAGING_ALLOWED_HOSTS=yourusername-staging.pythonanywhere.com
# Set to false once the three PythonAnywhere Scheduled Tasks for the nightly
# forecast/risk/insight jobs are confirmed running (see notes.md step 7) --
# leave true/unset until then so the jobs still run via the in-process scheduler.
APSCHEDULER_AUTOSTART=true
