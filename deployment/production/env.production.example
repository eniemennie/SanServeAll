# Set to false once the three PythonAnywhere Scheduled Tasks for the nightly
# forecast/risk/insight jobs are confirmed running (see notes.md steps 7-8) --
# leave true/unset until then so the jobs still run via the in-process scheduler.
APSCHEDULER_AUTOSTART=true
